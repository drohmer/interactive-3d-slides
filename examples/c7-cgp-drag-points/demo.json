{
  "title": "CGP: select and drag the control points of a curve",
  "kind": "cgp",
  "query": "controls=curve,points,polygon,reset,length&compact=1&panel=br",
  "panel": 5,
  "slide": "<button data-demo-set=\"curve=bezier\">Bezier</button> <button data-demo-set=\"curve=spline\">Spline</button> length = <span data-demo-value=\"length\" data-digits=\"2\"></span>",
  "steps": [
    {"expect": {"curve": "bezier", "points": 4, "polygon": true}},
    {"slide_on": ["Bezier"]},
    {"slide_shows": ["[data-demo-value=length]", "length", 2]},
    {"remember": "length"},
    {"snapshot": "start"},
    {"drag_pixels": {"pixels": "b > 150 && b - r > 80 && b - g > 40", "by": [0, -150]}},
    {"changed": "length"},
    {"slide_shows": ["[data-demo-value=length]", "length", 2]},
    {"snapshot": "dragged"},
    {"differ": ["start", "dragged"]},
    {"remember": "length"},
    {"slide_click": "Spline"},
    {"expect": {"curve": "spline"}},
    {"slide_on": ["Spline"]},
    {"changed": "length"},
    {"snapshot": "spline"},
    {"differ": ["dragged", "spline"]},
    {"set": {"points": 6}},
    {"expect": {"points": 6}},
    {"snapshot": "six"},
    {"differ": ["spline", "six"]},
    {"click": "Polygon"},
    {"expect": {"polygon": false}},
    {"snapshot": "no_polygon"},
    {"differ": ["six", "no_polygon"]},
    {"drag": [[1100, 120], [950, 120]]},
    {"snapshot": "turned"},
    {"differ": ["no_polygon", "turned"]}
  ],
  "poster": {"query": "curve=bezier", "wait": 0.5}
}
